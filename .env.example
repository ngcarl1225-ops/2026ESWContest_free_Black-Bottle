APP_NAME=Entrance Assistant Display
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 공공데이터포털에서 발급받은 후 채우고 USE_MOCK_DATA=false로 변경
KMA_SERVICE_KEY=
AIRKOREA_SERVICE_KEY=
USE_MOCK_DATA=true

# 기상청 단기예보 격자좌표 (python scripts/sync_location.py 로 자동 감지 가능, 기본값: 서울 종로구)
NX=60
NY=127

# 에어코리아 측정소명
AIRKOREA_STATION_NAME=종로구

# 기상청 생활기상지수(자외선) 구역코드
KMA_UV_AREA_NO=1100000000

# ---------- 화재 감지 ----------
# Pi 센서 -> 백엔드 공유 토큰 (비우면 인증 없이 허용). Pi 쪽 FIRE_TOKEN 과 일치시킬 것.
FIRE_TOKEN=
# 관리사무소 대시보드 조치(확인중/119신고/상황종료) 토큰 (비우면 누구나 허용)
FIRE_ADMIN_TOKEN=
# alarm 후 세대에서 취소 없으면 관리사무소로 자동 통보되기까지의 초
FIRE_ESCALATION_SECONDS=20
# 마지막 보고 이후 이 시간(초) 지나면 센서 오프라인 표시
FIRE_OFFLINE_SECONDS=30
# 불꽃 + 이 온도(℃) 이상 동시 -> 화재 경보
FIRE_TEMP_THRESHOLD_C=50.0
# "오경보예요" 취소 후 재경보를 막는 쿨다운(초)
FIRE_CANCEL_COOLDOWN_SECONDS=60
# 관리사무소 화면에 미리 등록할 세대: "아이디|표시이름" 콤마 구분 (비우면 첫 보고 시 자동 등록)
FIRE_UNITS=101-1203|101동 1203호,101-1204|101동 1204호,102-0901|102동 901호

# --- 아래는 라즈베리파이(센서 모듈)에서만 쓰는 값. scripts/fire_detection.py 참고 ---
# FIRE_BACKEND_URL=http://<디스플레이-서버-IP>:8000
# FIRE_UNIT_ID=101-1203
# FIRE_UNIT_LABEL=101동 1203호
# FIRE_FLAME_GPIO=4
# FIRE_REPORT_INTERVAL=1.0
